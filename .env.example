# Copy this file to .env and fill in real values. Never commit .env.
# All server settings use the PROOF_ prefix (src/core/config.py). The MCP
# client (fragola_mcp) reads PRIMA_API_URL separately.

# --- Environment ---
PROOF_ENV=development
PROOF_DATABASE_URL=

# --- Secrets: required in staging and production, generate your own ---
PROOF_STORAGE_SIGNING_SECRET=
PROOF_SESSION_SECRET=
PROOF_INTERNAL_API_TOKEN=

# --- Storage ---
PROOF_STORAGE_ROOT=storage
PROOF_STORE_ORIGINALS=false

# --- Evidence / OpenTimestamps ---
PROOF_EVIDENCE_ID_PREFIX=PRIMA
PROOF_OTS_MAX_RETRIES=3
PROOF_WORKER_INTERVAL_SECONDS=60

# --- Certificate ---
PROOF_PACKAGE_INCLUDE_ORIGINALS=true
PROOF_CERTIFICATE_MAX_ATTEMPTS=3
PROOF_CERTIFICATE_LAYOUT_PATH=
PROOF_CHROMIUM_NO_SANDBOX=false

# --- Notifications (external requires your own n8n workflow or equivalent) ---
PROOF_NOTIFICATION_DELIVERY=builtin
PROOF_NOTIFICATION_MAX_ATTEMPTS=10
PROOF_NOTIFICATION_WAKE_URL=

# --- MCP entry ---
PROOF_MCP_ENABLED=false
PROOF_MCP_RATE_PER_HOUR=60
PROOF_MCP_DECLARATION_RECEIPT_MINUTES=60

# --- Admin dashboard ---
PROOF_ADMIN_SESSION_HOURS=
PROOF_LOGIN_RATE_PER_HOUR=

# --- Reverse proxy (only if you run one in front) ---
PROOF_PROXY_IP_HEADER=
PROOF_TRUSTED_PROXY_IPS=

# --- Bot protection (required in staging and production) ---
PROOF_TURNSTILE_SITE_KEY=
PROOF_TURNSTILE_SECRET_KEY=
PROOF_FORM_GUARD_ENABLED=
PROOF_FORM_MIN_SECONDS=
PROOF_SUBMIT_RATE_PER_EMAIL_HOUR=
PROOF_SUBMIT_GLOBAL_PER_HOUR=
PROOF_RESEND_RATE_PER_REQUEST_HOUR=
PROOF_EXPIRED_FILES_RETENTION_HOURS=

# --- Portal web ---
PROOF_HOST=
PROOF_PORT=
PROOF_PUBLIC_BASE_URL=
PROOF_VERIFICATION_TTL_HOURS=
PROOF_EMAIL_LINK_TTL_HOURS=
PROOF_MAX_FILES_PER_REQUEST=
PROOF_MAX_FILE_MB=
PROOF_MAX_REQUEST_MB=
PROOF_MAX_VIDEO_MB=
PROOF_TEMP_BUDGET_MB=
PROOF_SUBMIT_RATE_PER_HOUR=
PROOF_VERIFY_RATE_PER_HOUR=

# --- Mail (development default writes to outbox/ instead of sending) ---
PROOF_OUTBOX_DIR=outbox
PROOF_ADMIN_EMAIL=

# --- MCP client (fragola_mcp), separate from the server's PROOF_ settings ---
PRIMA_API_URL=https://certified.fragola.agency
